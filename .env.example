# Copy this file to .env and fill in real values on the server (never commit .env)
PORT=8787

# SMTP settings — Hostinger email example shown; adjust for your provider
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@zuvisoft.in
SMTP_PASS=your-mailbox-password
SMTP_FROM="ZuviSoft Website" <hello@zuvisoft.in>

# Where contact form submissions are delivered
CONTACT_TO=hello@zuvisoft.in
